# Database backend for local runs: "sqlite" (default) or "postgresql".
# Docker Compose forces postgresql on the web service, so local stays SQLite.
DB_ENGINE=sqlite

# PostgreSQL (used only when DB_ENGINE=postgresql)
POSTGRES_DB=readers_nook
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis (cache). In docker-compose this is set to redis://redis:6379/1
REDIS_URL=redis://127.0.0.1:6379/1

# Hardcover API
HARDCOVER_API_URL=https://api.hardcover.app/v1/graphql
HARDCOVER_API_TOKEN=
HARDCOVER_USER_AGENT=ReadersNook/0.1
SEARCH_BACKEND=hardcover
CATALOG_PROVIDER=hardcover
